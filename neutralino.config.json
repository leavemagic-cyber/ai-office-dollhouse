{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "tw.owner.aioffice.dollhouse",
  "version": "0.3.6",
  "applicationName": "AI Office Dollhouse",
  "applicationIcon": "resources/icons/app-icon.png",
  "author": "AI Office Dollhouse contributors",
  "description": "A read-only Windows overlay for local coding-agent activity",
  "copyright": "Copyright © 2026 AI Office Dollhouse contributors",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.exit",
    "app.getConfig",
    "app.getPath",
    "app.getProcessId",
    "computer.getMemoryInfo",
    "events.*",
    "filesystem.createDirectory",
    "filesystem.getStats",
    "filesystem.move",
    "filesystem.readBinaryFile",
    "filesystem.readFile",
    "filesystem.remove",
    "filesystem.writeFile",
    "os.execCommand",
    "os.getEnv",
    "os.spawnProcess",
    "os.showMessageBox",
    "window.*"
  ],
  "modes": {
    "window": {
      "title": "AI 玩偶辦公室",
      "icon": "/resources/icons/app-icon.png",
      "width": 240,
      "height": 160,
      "minWidth": 118,
      "minHeight": 82,
      "maxWidth": 900,
      "maxHeight": 1600,
      "x": 6,
      "y": 160,
      "center": false,
      "fullScreen": false,
      "alwaysOnTop": true,
      "enableInspector": false,
      "borderless": true,
      "transparent": true,
      "maximize": false,
      "hidden": true,
      "resizable": true,
      "useLogicalPixels": true,
      "exitProcessOnClose": true
    },
    "browser": {
      "nativeBlockList": [
        "filesystem.*",
        "os.*",
        "window.*"
      ]
    }
  },
  "cli": {
    "binaryName": "ai-office-dollhouse",
    "resourcesPath": "/resources/",
    "resourcesExclude": ".*-transparent\\.png$",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
