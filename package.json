{
  "name": "ai-office-dollhouse",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "description": "A read-only Windows overlay for local coding-agent activity.",
  "scripts": {
    "start": "neu run",
    "dev": "neu run -- --window-enable-inspector=true",
    "build:relay": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-relay.ps1",
    "build:click-through": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-click-through.ps1",
    "pretest": "npm run build:relay && npm run build:click-through",
    "test": "node --test tests/*.test.mjs",
    "test:soak": "node scripts/soak-test.mjs",
    "check": "node scripts/check-project.mjs",
    "build": "neu build --release",
    "package:win": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leavemagic-cyber/ai-office-dollhouse.git"
  },
  "bugs": {
    "url": "https://github.com/leavemagic-cyber/ai-office-dollhouse/issues"
  },
  "homepage": "https://github.com/leavemagic-cyber/ai-office-dollhouse#readme",
  "license": "MIT"
}
